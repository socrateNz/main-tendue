# Copier ce fichier en .env.local et renseigner les valeurs (ne jamais committer .env.local).
# Vérification : npm run check:services

# --- MongoDB Atlas : Connect > Drivers (remplacer <db_password>) ---
MONGODB_URI=
MONGODB_DB=parrainage

# --- Cloudinary : Settings > API Keys > « API environment variable » ---
# Format : cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# --- Secrets (≥ 32 caractères) — générer chacun avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CRON_SECRET=

# --- URL publique de l'application (liens vidéo envoyés aux sponsors) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
